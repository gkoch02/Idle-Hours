[Unit]
Description=Idle Hours eInk display service
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify pairs with sd_notify("READY=1") at end of run_clock.main()
# startup and sd_notify("WATCHDOG=1") from the heartbeat. With WatchdogSec
# set, systemd restarts the service when the watchdog ping goes silent for
# longer than the interval — i.e. a wedged-but-breathing loop that plain
# Type=simple would never notice.
#
# The 180s cap is 3x the 60s heartbeat interval. That margin only holds
# because the ping is decoupled from tick duration (#236): run_clock also
# pings at every render/display subprocess boundary and immediately before
# the main loop's blocking render-lock acquire, so the worst-case gap between
# two pings is ONE subprocess timeout (DISPLAY_TIMEOUT_SECONDS, 60s) or the
# inter-tick sleep (60s) — not their sum, and not plus a lock wait. With a
# tick-top-only ping the true worst case was a lock wait behind another
# render plus this loop's own render+display plus the sleep (~270s), which
# would have had systemd kill a working appliance.
Type=notify
WatchdogSec=180s

User=pi
WorkingDirectory=/home/pi/IdleHours

# StateDirectory=idle-hours makes systemd create /var/lib/idle-hours owned by the
# service User (`pi` here) before ExecStart runs, and exposes it as %S/idle-hours
# below. That is the system-managed replacement for the historical
# ~/.idle-hours/ directory — under the sandbox below ($HOME is read-only — see
# ProtectHome), a writable state dir under /var/lib is the least-surprising
# option. Migration: ~/.idle-hours/ on older installs; symlink it to
# /var/lib/idle-hours during the transition (see pi_setup_inky_impression.md).
StateDirectory=idle-hours

# All persistent settings live in the config file. Copy the shipped example
# (``idle_hours/assets/config.toml.example`` inside the installed package, or
# the repo's ``idle_hours/assets/config.toml.example`` for a checkout) into
# %S/idle-hours/config.toml and edit there — the systemd unit itself stays
# stable across config changes, so you only ever ``systemctl restart`` (no
# ``daemon-reload``) when tuning the appliance. CLI flags still override
# config values; use them for ad-hoc runs.
#
# ``python -m idle_hours.run_clock`` invokes the package entry point. The
# ``idle-hours run`` console script is equivalent; prefer the ``-m`` form
# under systemd because it has zero PATH-resolution surprises.
ExecStart=/home/pi/.virtualenvs/pimoroni/bin/python -m idle_hours.run_clock \
  --config %S/idle-hours/config.toml

# Reads the prebuilt baked DB at idle_hours/assets/quote_database.jsonl (the
# canonical runtime input). idle_hours/assets/candidates-attributed.jsonl is
# the raw corpus that feeds the baker and stays on disk as a defensive
# fallback + curator-UI input. Both ship inside the wheel as package-data.
# Rebuilding corpus artifacts is a separate maintenance task, not part of
# service startup.

Restart=always
RestartSec=10
# "Do not restart" exit code for terminal configuration errors. run_clock
# exits with runtime_config.EXIT_CONFIG_ERROR (42) on a typoed --config path
# or a failed pre-flight path check, so a configuration bug halts the unit
# loudly in the journal instead of flapping against Restart=always.
# Pidfile contention deliberately stays exit 1 — a racing `systemctl restart`
# SHOULD be retried, not latched off.
# NB: this is RestartPreventExitStatus, NOT RestartForceExitStatus — the
# Force variant does the opposite (restarts *even when* Restart=no would
# otherwise suppress it), which is not what we want here.
RestartPreventExitStatus=42

# Explicit journald wiring. Default behaviour is the same, but stating it
# makes the contract visible and survives sandboxing changes that might
# otherwise silently redirect output.
StandardOutput=journal
StandardError=journal

# ---- Sandboxing -------------------------------------------------------------
# Modest least-privilege hardening. `systemd-analyze security idle-hours.service`
# should show a meaningful improvement over an unsandboxed unit. These are
# conservative defaults — if you run into trouble, strip them one at a time
# and re-run systemd-analyze security to see what you gave up.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# ReadWritePaths carves holes in ProtectSystem=strict / ProtectHome=read-only
# so the service can write its state dir + the render output file. %S expands
# to /var/lib (since StateDirectory= exists); the WorkingDirectory carve-out
# is needed for the default --output=output/current.png write path.
#
# CURATOR UI: the installed package directory stays read-only under
# ProtectSystem=strict, and that is where the selection-overrides sidecar,
# the content-overrides sidecar, and the baked quote DB live BY DEFAULT. With
# those defaults the curator UI can browse but not save — POST /api/overrides,
# POST /api/content-overrides and POST /api/bake all fail with a
# read-only-filesystem error (HTTP 500).
#
# The fix is to relocate those four files into the state dir (already writable
# via the carve-out below) rather than to widen the sandbox: set `overrides`,
# `content_overrides`, `raw_corpus` and `baked_db` in
# %S/idle-hours/config.toml — see idle_hours/assets/config.toml.example, which
# ships them pre-filled. run_clock seeds each relocated file from the bundled
# copy on first boot, so the committed bans and content fixes migrate across
# with no manual step. Do NOT add the package directory to ReadWritePaths;
# writing into site-packages defeats the sandbox and is clobbered on upgrade.
ReadWritePaths=%S/idle-hours /home/pi/IdleHours/output
# Kernel / IPC hardening. These are free for a render loop that only uses
# POSIX sockets + GPIO / SPI / I2C char devices — which is what Idle Hours
# actually does today.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
# MemoryDenyWriteExecute blocks pages that are simultaneously writable and
# executable. Pillow and the Pimoroni Inky stack are fine (their C extensions
# load RX, not W+X). Re-check if you later add a JIT-using dependency
# (numba, numpy-with-JIT, some ctypes-trampoline patterns); those will fail
# with EPERM and the failure mode is non-obvious.
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
# Syscall filter: allow the standard system-service set. Button listener,
# Inky SPI/I2C, HTTP server, file I/O all fall inside @system-service.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ---- Button-D shutdown vs sandboxing ----------------------------------------
# NoNewPrivileges=yes blocks setuid binaries, which means the default
# `sudo -n shutdown -h now` used by button D's 2s long press will FAIL under
# this unit. Two options:
#   1. Set --shutdown-command "systemctl poweroff" in ExecStart. polkit on
#      Raspberry Pi OS allows the active console user to poweroff without a
#      password, and systemctl is not setuid so NoNewPrivileges doesn't block it.
#      Verify with: systemctl poweroff  (as the pi user)
#   2. Leave --shutdown-command as the sudo default and drop NoNewPrivileges=yes
#      from this file if you want the stronger sandbox trade-off the other way.
# Either is fine; option 1 is the recommended default because it keeps the
# sandbox intact.

[Install]
WantedBy=multi-user.target
