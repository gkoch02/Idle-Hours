# Example Idle Hours appliance config.
#
# Every key here maps 1:1 to the argparse `dest` in
# idle_hours.run_clock.parse_args (snake_case, not kebab-case). A CLI flag
# always overrides the value here, and an absent key falls back to the
# argparse default — so you only need to list keys you actually want to
# change.
#
# Copy to e.g. /var/lib/idle-hours/config.toml (or wherever your StateDirectory
# is) and reference it from the systemd unit as:
#     ExecStart=... python -m idle_hours.run_clock --config /var/lib/idle-hours/config.toml
#
# Transient shell-only flags (--once, --skip-preflight, --config itself)
# are deliberately rejected here with a stderr warning; pass those on the
# CLI.

# ---- Render / display pipeline ---------------------------------------------
render_script  = "render_quote.py"
display_script = "display_inky.py"
output         = "output/current.png"
mode           = "production"         # production | debug
theme          = "auto"               # any registered theme name, or "auto" / "random".
                                      # `idle-hours run --help` prints the full list; the
                                      # canonical order is render_quote.THEME_ORDER.
# `theme = "random"` picks a fresh theme each time the displayed quote
# changes; the pick is not persisted across restarts. Button B / the web
# UI dropdown still overrides until midnight, same as for `auto`.
#
# When `theme = "auto"`, these pick the day-window (06:00–18:00) and
# night-window (18:00–06:00) themes. Defaults match the historical binary
# contract; broaden the rotation by setting one or both, e.g.
#   auto_day_theme   = "scholar"
#   auto_night_theme = "nightvision"
# 'auto' itself is rejected — that would be a config typo, not a recursion.
auto_day_theme   = "default"
auto_night_theme = "dark"
width          = 800
height         = 480
interval_seconds = 60

# ---- Persistent runtime state ----------------------------------------------
# These paths are typically under systemd's StateDirectory. Use absolute
# paths so the service works regardless of WorkingDirectory.
state_path     = "/var/lib/idle-hours/state.json"
history_path   = "/var/lib/idle-hours/history.jsonl"
history_days   = 7
telemetry_path = "/var/lib/idle-hours/telemetry.jsonl"
telemetry_retain_days = 90
pidfile        = "/var/lib/idle-hours/run_clock.pid"

# ---- Corpus + curator-owned sidecars ---------------------------------------
# REQUIRED for the curator UI under the shipped systemd unit.
#
# These four files default to locations inside the installed package. The unit
# sets `ProtectSystem=strict`, which mounts that read-only — so with the
# defaults, every curator save (`POST /api/overrides`,
# `POST /api/content-overrides`) and every "Bake now" (`POST /api/bake`)
# fails with a read-only-filesystem error and returns HTTP 500.
#
# Relocating them into StateDirectory (%S/idle-hours = /var/lib/idle-hours,
# already granted by `ReadWritePaths=` in the unit) makes the whole documented
# curation workflow work with no further sandbox changes.
#
# Migration is automatic: on startup run_clock copies the bundled file to any
# of these paths that doesn't exist yet, so the committed bans/boosts and
# per-row content fixes carry over on the first boot. Existing files are never
# overwritten, so this is safe to leave enabled across restarts.
#
# Both the runtime picker AND the curator UI read these same paths — that's
# deliberate. A curator edit the render path can't see is worse than no edit.
overrides         = "/var/lib/idle-hours/selection_overrides.json"
content_overrides = "/var/lib/idle-hours/content_overrides.json"
raw_corpus        = "/var/lib/idle-hours/candidates-attributed.jsonl"
baked_db          = "/var/lib/idle-hours/quote_database.jsonl"

# ---- Quiet hours -----------------------------------------------------------
# Overnight ranges (start > end) are supported. Set `quiet_off = true` to
# disable entirely (24/7 rendering).
quiet_start = "22:00"
quiet_end   = "06:00"
# Three-way choice for what gets pushed at the rising edge:
#   "<path>"  — copy a static PNG (e.g. assets/goodnight.png — the dark default).
#   "auto"    — render a centred "Good night." in the active theme on the fly.
#               Pairs nicely with `theme = "auto"` + auto_day/night themes so
#               the goodnight frame matches the rest of the UI.
#   ""        — render the picked quote at quiet_start (last-quote-of-the-night).
quiet_image = "assets/goodnight.png"
quiet_off   = false

# ---- Buttons / shutdown ----------------------------------------------------
# Set `buttons_off = true` on dev machines or headless runs. Note:
# `buttons_off` / `quiet_off` are argparse `store_true` flags, which means
# the CLI can only *enable* them (there's no paired --buttons-on). Setting
# either to `true` here makes that choice permanent until the key is
# removed — don't set them unless you want them permanent.
#
# The default shutdown command assumes passwordless sudo; under the
# sandboxed systemd unit (NoNewPrivileges=yes) use "systemctl poweroff"
# instead, or leave this empty to disable the button-D long-press
# shutdown entirely.
buttons_off      = false
shutdown_command = "systemctl poweroff"

# Optional frame pushed to the panel at boot so it doesn't ghost
# yesterday's frame during the cold-start Spectra 6 refresh. Comment out
# to skip the startup frame (saves 10–20s at boot). Same three-way choice
# as quiet_image:
#   "<path>"  — copy a static PNG.
#   "auto"    — render "Good night." in the active theme on the fly.
# startup_image = "auto"

# ---- Curator web UI (optional) ---------------------------------------------
# Off by default. Loopback binds (127.0.0.1, ::1) don't need a token; any
# other bind REQUIRES web_token_file (or web_token). Prefer web_token_file
# so the secret never appears in `ps` / journald.
# web_bind       = "127.0.0.1:8080"
# web_token_file = "/var/lib/idle-hours/web.token"

# ---- Webhook notifications (optional, v2) ----------------------------------
# When set, the loop POSTs a JSON body for each alert-worthy telemetry event
# (errors, render/display/shutdown timeouts, backoff entered, button-died,
# state validation issues, web auth failures). Heartbeats and successful
# renders are always filtered (alerting once a minute is spam, not signal),
# even when webhook_all_events = true. Best-effort: dispatched on a daemon
# thread with a 5s timeout, failures log but never block the render path.
#
# Set webhook_all_events = true to widen the filter to "everything except
# heartbeats and successful renders" (operator actions, quiet-hours
# transitions, etc.).
# webhook_url        = "https://hooks.example.test/idle-hours"
# webhook_all_events = false
