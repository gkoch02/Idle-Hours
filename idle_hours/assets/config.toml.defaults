# Idle Hours default config — every key set to the value run_clock.py would
# use if no config file were passed. Safe to copy verbatim:
#
#     cp idle_hours/assets/config.toml.defaults ~/.idle-hours/config.toml
#     idle-hours run --config ~/.idle-hours/config.toml
#
# …is behaviourally identical to `idle-hours run` with no --config.
# Use this when you want an explicit, always-know-what-you're-running
# reference you can check into your deployment repo and diff against
# future upstream bumps. For the appliance-oriented preset with
# /var/lib/idle-hours/ paths, production mode, and systemctl-poweroff,
# see idle_hours/assets/config.toml.example instead.
#
# Two CLI defaults are `None` (argparse) and therefore OMITTED here,
# since TOML has no null: `display_script`, `startup_image`. Set them
# to a string path to enable the feature.
#
# Transient flags refused in the config (and unconditionally dropped
# with a stderr warning): `once`, `skip_preflight`, `config`. Pass
# those on the CLI.

# ---- Render / display pipeline ---------------------------------------------
render_script    = "render_quote.py"
# display_script = "display_inky.py"   # Pi-only; default is unset.
output           = "output/current.png"
mode             = "debug"
theme            = "default"
# Valid: any registered theme name (fifty-nine themes ship today; `idle-hours run
# --help` prints the full list and render_quote.THEME_ORDER is the canonical
# order), "auto" (wall-clock day/night), or "random" (rerolls each time the
# displayed quote changes; not persisted across restarts).
#
# When `theme = "auto"`, these pick the day/night theme. Defaults match the
# legacy binary contract; broaden the rotation by setting one or both to any
# registered theme name (e.g. "scholar" / "nightvision"). 'auto' is rejected.
auto_day_theme   = "default"
auto_night_theme = "dark"
width            = 800
height           = 480
interval_seconds = 60

# ---- Persistent runtime state ----------------------------------------------
# Default paths live under ~/.idle-hours/ for dev convenience. Under the
# sandboxed systemd unit (ProtectHome=read-only) swap these to
# /var/lib/idle-hours/... — see assets/config.toml.example.
state_path            = "~/.idle-hours/state.json"
history_path          = "~/.idle-hours/history.jsonl"
history_days          = 7
telemetry_path        = "~/.idle-hours/telemetry.jsonl"
telemetry_retain_days = 90
pidfile               = "~/.idle-hours/run_clock.pid"

# ---- Quiet hours -----------------------------------------------------------
quiet_start = "22:00"
quiet_end   = "06:00"
quiet_image = "assets/goodnight.png"
quiet_off   = false

# ---- Buttons / shutdown ----------------------------------------------------
# NOTE: `buttons_off` and `quiet_off` are argparse `store_true` flags.
# The CLI can only *enable* them (no paired --buttons-on exists), so a
# config that sets them to `true` can't be overridden from the shell.
# Leaving them as `false` here preserves CLI flexibility.
buttons_off      = false
shutdown_command = "sudo -n shutdown -h now"
# startup_image  = "assets/goodnight.png"   # default is unset.

# ---- Curator web UI --------------------------------------------------------
# Off by default (empty web_bind). Non-loopback binds also require
# web_token_file (or web_token); prefer the file form.
web_bind       = ""
web_token      = ""
web_token_file = ""

# ---- Webhook notifications -------------------------------------------------
# Off by default (empty webhook_url). When set, an HTTP POST with a JSON
# body fires for each interesting telemetry event (errors, render/display/
# shutdown timeouts, backoff entered, button listener died, state validation
# issues). Heartbeats and successful renders are NOT posted by default;
# `webhook_all_events = true` widens the filter to "everything except
# heartbeats and successful renders".
webhook_url        = ""
webhook_all_events = false

# ---- Corpus + curator-owned sidecars ---------------------------------------
# The four files the curator UI mutates (selection bans/boosts, per-row
# content fixes, and the baked DB that "Bake now" rewrites), plus the raw
# corpus the baker reads. These defaults point INSIDE the installed package,
# which a `ProtectSystem=strict` systemd unit mounts read-only — under that
# unit every curator save and every bake fails with HTTP 500.
#
# For an appliance install, relocate all four into the writable state dir
# (see config.toml.example). run_clock seeds any relocated file that doesn't
# exist yet from the bundled copy, so a first boot migrates the committed
# bans and content fixes across with no manual step.
#
# Whatever these are set to is used by BOTH the runtime picker and the
# curator UI — a curator edit the render path can't see is worse than no
# edit at all, so they must never be split.
# Unset by default (like `startup_image`), which means "use the bundled copy
# inside the installed package". TOML has no null literal, so the defaults
# live here commented out rather than as active keys.
# overrides         = "/var/lib/idle-hours/selection_overrides.json"
# content_overrides = "/var/lib/idle-hours/content_overrides.json"
# raw_corpus        = "/var/lib/idle-hours/candidates-attributed.jsonl"
# baked_db          = "/var/lib/idle-hours/quote_database.jsonl"
